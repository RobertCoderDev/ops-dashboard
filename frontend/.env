# Frontend (Vite). Copia a frontend/.env.local si es necesario.
#
# En desarrollo NO hace falta: el proxy de vite.config.js redirige /api a
# http://localhost:4000.
#
# En producción (build), define la URL base del backend:
#   VITE_API_URL=https://api.tudominio.com
# (si no se define, las peticiones usan /api relativo al mismo dominio)
VITE_API_URL=
