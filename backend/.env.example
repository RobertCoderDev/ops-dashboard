# Copia este archivo como backend/.env y ajusta los valores.
# El servidor carga .env automáticamente (ver backend/env.js).

# Puerto del servidor (default 4000)
PORT=4000

# Obligatorio en producción: secreto para firmar los JWT.
# Genera una clave segura con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# production | development (en production JWT_SECRET es obligatorio)
NODE_ENV=development

# Origen permitido del frontend (CSV si hay varios)
# En producción: https://tudominio.com
CORS_ORIGINS=http://localhost:5173
